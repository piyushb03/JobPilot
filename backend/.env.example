# ========================
# JobPilot — Environment Variables
# ========================

# --- Database ---
# SQLite (local dev, no setup required):
DATABASE_URL=sqlite:///./sql_app.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/jobpilot

# --- Authentication ---
# REQUIRED: Change this to a strong random string in production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-strong-secret-key-here

# --- Internal Scheduler ---
# Secret used to authenticate Cloud Scheduler pings to /api/internal/scheduled-nudges
# REQUIRED: Change this in production
INTERNAL_CRON_SECRET=your-internal-cron-secret-here

# --- CORS ---
# Comma-separated list of allowed frontend origins
# Dev default: localhost:5173 and localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ========================
# AI Configuration (pick ONE option)
# ========================

# OPTION A: Use Google Gemini API key (easiest — no GCP setup required)
# Get your key at: https://aistudio.google.com/app/apikey
# Set USE_MOCK_AI=false and provide the key below
USE_MOCK_AI=false
GEMINI_API_KEY=your-gemini-api-key-here

# OPTION B: Use Google Cloud Vertex AI (requires GCP project + authentication)
# Authenticate with: gcloud auth application-default login
# USE_MOCK_AI=false
# GCP_PROJECT=your-gcp-project-id
# GCP_LOCATION=us-central1

# OPTION C: Use mock AI (for development without any API keys)
# USE_MOCK_AI=true
