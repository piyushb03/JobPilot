# ========================
# JobPilot — Environment Variables
# ========================

# --- Database ---
# SQLite (local dev, no setup required):
DATABASE_URL=sqlite:///./sql_app.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/jobpilot

# --- Authentication ---
# REQUIRED: Change this to a strong random string in production
SECRET_KEY=your-strong-secret-key-here

# --- Internal Scheduler ---
INTERNAL_CRON_SECRET=your-internal-cron-secret-here

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ========================
# AI Configuration (pick ONE option)
# ========================

# OPTION A: Gemini API key (easiest — get at https://aistudio.google.com/app/apikey)
USE_MOCK_AI=false
GEMINI_API_KEY=your-gemini-api-key-here

# OPTION B: Vertex AI (requires GCP project + gcloud auth application-default login)
# GCP_PROJECT=your-gcp-project-id
# GCP_LOCATION=us-central1

# OPTION C: Mock AI (no keys required — for local dev)
# USE_MOCK_AI=true
